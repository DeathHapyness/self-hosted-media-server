# Python (cache do install.py)
__pycache__/
*.pyc

# Ambiente / segredos
.env
*.env
*.key
*.pem
*.token

# Diretórios de configuração/dados gerados pelos containers
# (cobre config/, config/logs/, config/database.db etc. de qualquer serviço)
config/
data/
cache/
work/

# Exceção: homepage/config guarda a configuração do dashboard (não são
# dados gerados pelo container), então deve ser versionada. O .env
# continua ignorado pelas regras de segredo acima.
!homepage/config/
!homepage/config/*.yaml
!homepage/config/*.css
!homepage/config/*.env

# Pastas específicas de dados que não seguem o padrão "config/"
monitoring/prometheus-data/
monitoring/grafana-data/
scrutiny/influxdb/
ntopng/redis-data/
ntopng/ntopng-data/
jellyfin/cache/
jellyfin/media/
navidrome/music/

# Tailscale
tailscale/

# Bancos de dados e logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Sistema
.DS_Store
Thumbs.db

# Ferramentas externas clonadas manualmente dentro do repo (ex.: PortWatch)
PortWatch/
