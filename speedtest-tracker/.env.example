# Copie este arquivo para ".env" e gere sua própria APP_KEY.
# NUNCA versione o arquivo ".env" real (ele já está no .gitignore).
#
# Gerar uma chave nova (32 bytes em base64):
#   openssl rand -base64 32
#
# O valor final deve ter o prefixo "base64:", exemplo:
#   APP_KEY=base64:SUA_CHAVE_GERADA_AQUI=

APP_KEY=
